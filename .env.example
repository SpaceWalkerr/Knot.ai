# ─────────────────────────────────────────────────────────────
# Knot.ai — copy to apps/server/.env and fill in.
# The web app reads only the VITE_* vars (see apps/web/.env.example).
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=8787
# Public URL where Agora's cloud can reach THIS server's /v1/chat/completions.
# In dev this is your cloudflared/ngrok tunnel URL. Must NOT be localhost.
PUBLIC_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com

# --- Anthropic (interviewer brain + digests + grounded summary) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model for the live voice loop (fast) and for the offline summary (can be the same).
ANTHROPIC_LIVE_MODEL=claude-sonnet-5
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5

# Shared secret Agora must present when calling our proxy (set as a header in the
# Convo AI llm.api_key field). Any random string; protects the open endpoint.
PROXY_SHARED_SECRET=change-me-to-a-random-string

# --- Agora ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# RESTful API (Developer Toolkit) — used as Basic auth for Convo AI REST calls
AGORA_REST_CUSTOMER_ID=
AGORA_REST_CUSTOMER_SECRET=
# UID the cloud agent joins as (any int not used by a human)
AGORA_AGENT_UID=1000

# --- TTS ---
# ⚠️ TTS failures are SILENT in Agora Convo AI: with bad/missing credentials the
# agent still joins the channel, reports RUNNING, accepts /speak with 200 — and
# never makes a sound. Only the vendor NAME is validated at join. The server
# warns at boot if the selected vendor has no credentials; heed it.
TTS_VENDOR=minimax

# MiniMax (verified 2026-09-04: NOT pre-provisioned — these are required).
MINIMAX_GROUP_ID=
MINIMAX_API_KEY=
MINIMAX_TTS_VOICE=English_radiant_girl
# Per-persona voices, so a three-interviewer panel doesn't sound like one person.
# Copy voice_id values from the MiniMax console; blank falls back to the above.
MINIMAX_VOICE_NEUTRAL_FEMALE=
MINIMAX_VOICE_WARM_MALE=
MINIMAX_VOICE_NEUTRAL_MALE=
MINIMAX_VOICE_WARM_FEMALE=
MINIMAX_VOICE_BRISK_FEMALE=

# Alternatives — set TTS_VENDOR to match.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# --- Persistence ---
DB_PATH=./data/knot.sqlite
