# See the root .env.example for the annotated list. Copy this file to apps/server/.env
PORT=8787
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

ANTHROPIC_API_KEY=
ANTHROPIC_LIVE_MODEL=claude-sonnet-5
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5
PROXY_SHARED_SECRET=change-me

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_CUSTOMER_ID=
AGORA_REST_CUSTOMER_SECRET=
AGORA_AGENT_UID=1000

# --- TTS ---
# ⚠️ TTS failures are SILENT in Agora Convo AI: with bad/missing credentials the
# agent still joins the channel, reports RUNNING, accepts /speak with 200 — and
# never makes a sound. Only the vendor NAME is validated at join. The server
# warns at boot if the selected vendor has no credentials; heed it.
TTS_VENDOR=minimax

# MiniMax (verified 2026-09-04: NOT pre-provisioned — these are required).
MINIMAX_GROUP_ID=
MINIMAX_API_KEY=
MINIMAX_TTS_VOICE=English_radiant_girl
# Per-persona voices, so a three-interviewer panel doesn't sound like one person.
# Copy voice_id values from the MiniMax console; blank falls back to the above.
MINIMAX_VOICE_NEUTRAL_FEMALE=
MINIMAX_VOICE_WARM_MALE=
MINIMAX_VOICE_NEUTRAL_MALE=
MINIMAX_VOICE_WARM_FEMALE=
MINIMAX_VOICE_BRISK_FEMALE=

# Alternatives — set TTS_VENDOR to match.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

DB_PATH=./data/knot.sqlite

# When true, the server runs without calling Agora REST (agent lifecycle is mocked).
# Use this until Conversational AI Engine access is confirmed.
MOCK_AGORA=true
