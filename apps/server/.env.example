# See the root .env.example for the annotated list. Copy this file to apps/server/.env
PORT=8787
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

ANTHROPIC_API_KEY=
ANTHROPIC_LIVE_MODEL=claude-sonnet-5
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5
PROXY_SHARED_SECRET=change-me

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_REST_CUSTOMER_ID=
AGORA_REST_CUSTOMER_SECRET=
AGORA_AGENT_UID=1000

TTS_VENDOR=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_TTS_KEY=
AZURE_TTS_REGION=

DB_PATH=./data/knot.sqlite

# When true, the server runs without calling Agora REST (agent lifecycle is mocked).
# Use this until Conversational AI Engine access is confirmed.
MOCK_AGORA=true
